{
  "name": "otterchat",
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@10.12.4",
  "imports": {
    "#*": "./agent/*",
    "#evals/*": "./evals/*"
  },
  "scripts": {
    "build": "next build",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:migrate:production": "vercel env run -e production -- pnpm db:migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "dev": "next dev",
    "start": "next start",
    "ios": "cap run ios",
    "ios:sync": "cap sync ios",
    "ios:open": "cap open ios",
    "android": "adb reverse tcp:3000 tcp:3000 && cap run android",
    "android:sync": "cap sync android",
    "android:open": "cap open android",
    "typecheck": "next typegen && tsgo --noEmit -p tsconfig.json",
    "build:eve": "eve build",
    "dev:eve": "eve dev",
    "start:eve": "eve start"
  },
  "dependencies": {
    "@capacitor/core": "8.5.0",
    "@capacitor/keyboard": "8.0.5",
    "@launchdarkly/node-server-sdk": "^9.13.1",
    "@neondatabase/auth": "0.4.2-beta",
    "@neondatabase/serverless": "1.0.2",
    "@sentry/nextjs": "^10",
    "@shikijs/core": "4.1.0",
    "@shikijs/engine-javascript": "4.1.0",
    "@shikijs/engine-oniguruma": "4.1.0",
    "@streamdown/cjk": "1.0.3",
    "@streamdown/code": "1.1.1",
    "@streamdown/math": "1.0.2",
    "@streamdown/mermaid": "1.0.2",
    "@tailwindcss/postcss": "4.3.0",
    "@vercel/analytics": "2.0.1",
    "@vercel/speed-insights": "2.0.0",
    "@vercel/toolbar": "^0.2.7",
    "ai": "7.0.0-canary.171",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "drizzle-orm": "0.45.1",
    "eve": "^0.22.1",
    "flags": "^4.3.1",
    "lucide-react": "1.16.0",
    "next": "16.3.0",
    "radix-ui": "1.4.3",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "shiki": "4.1.0",
    "streamdown": "2.5.0",
    "tailwind-merge": "3.6.0",
    "tailwindcss": "4.3.0",
    "use-stick-to-bottom": "1.1.4",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@capacitor/android": "8.5.0",
    "@capacitor/cli": "8.5.0",
    "@capacitor/ios": "8.5.0",
    "@types/node": "^25.9.3",
    "@types/react": "19.2.15",
    "@types/react-dom": "19.2.3",
    "@typescript/native-preview": "7.0.0-dev.20260523.1",
    "drizzle-kit": "0.31.9",
    "microsandbox": "^0.5.7",
    "typescript": "5.9.3"
  }
}
