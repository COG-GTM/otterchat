# Production mode. Without every value in this section, `next dev` runs in
# local development mode with browser storage; deployments fail closed.
DATABASE_URL=
NEON_AUTH_BASE_URL=
NEON_AUTH_COOKIE_SECRET=

# LaunchDarkly server-side SDK key (Environments -> SDK key).
LAUNCHDARKLY_SDK_KEY=

# Optional, only used to build the "manage in LaunchDarkly" links shown in the
# Flags Explorer. Defaults to project "default", environment "production".
LAUNCHDARKLY_PROJECT_KEY=
LAUNCHDARKLY_ENVIRONMENT=

# 32 random bytes, base64url encoded. Authorizes the Vercel Toolbar's Flags
# Explorer against /.well-known/vercel/flags and signs its local overrides.
# Generate with: node -e "console.log(crypto.randomBytes(32).toString('base64url'))"
FLAGS_SECRET=

# Optional: enable hosted Vercel Connect integrations.
SLACK_CONNECTOR=
LINEAR_CONNECTOR=
NOTION_CONNECTOR=
SENTRY_CONNECTOR=

# Sentry only reports from Vercel production/preview deployments. Set to 1 to
# also send events from a local dev server (server/edge and browser).
SENTRY_ENABLED=
NEXT_PUBLIC_SENTRY_ENABLED=
