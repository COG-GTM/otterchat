{
  "name": "ottervote",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "next build",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "node --env-file-if-exists=.env.local --experimental-strip-types scripts/seed.ts",
    "db:studio": "drizzle-kit studio",
    "pairs:generate": "node --env-file-if-exists=.env.local --experimental-strip-types scripts/generate-pairs.ts",
    "dev": "next dev --port 3100",
    "start": "next start --port 3100",
    "typecheck": "next typegen && tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@neondatabase/serverless": "1.0.2",
    "@otterchat/ui": "workspace:*",
    "@tailwindcss/postcss": "4.3.0",
    "@vercel/blob": "2.8.0",
    "ai": "7.0.0-canary.171",
    "drizzle-orm": "0.45.1",
    "lucide-react": "1.16.0",
    "next": "16.3.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "tailwindcss": "4.3.0"
  },
  "devDependencies": {
    "@types/node": "^25.9.3",
    "@types/react": "19.2.15",
    "@types/react-dom": "19.2.3",
    "drizzle-kit": "0.31.9",
    "typescript": "5.9.3"
  }
}
