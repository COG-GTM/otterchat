# Neon Postgres for the vote app. Use a database separate from otterchat.
DATABASE_URL=

# Shared secret for POST /api/pairs and GET /api/export. Generate with:
# node -e "console.log(crypto.randomBytes(32).toString('base64url'))"
INGEST_TOKEN=

# otterimage proxy auth + Blob store for "write your own prompt" and scripts/generate-pairs.ts
OTTERIMAGE_MODAL_KEY=
OTTERIMAGE_MODAL_SECRET=
BLOB_READ_WRITE_TOKEN=

# AI-written prompts in scripts/generate-pairs.ts go through the AI Gateway (or VERCEL_OIDC_TOKEN from vercel env pull)
AI_GATEWAY_API_KEY=
